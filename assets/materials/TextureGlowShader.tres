code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D selectable_texture;
uniform vec4 glow_color : source_color = vec4(0.972549, 0.000000, 0.952941, 1.000000);



void fragment() {
	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(selectable_texture, UV);
	float n_out2p4 = n_out2p0.a;


// ColorParameter:6
	vec4 n_out6p0 = glow_color;


	vec3 n_out5p0;
// If:5
	float n_in5p1 = 0.00000;
	float n_in5p2 = 0.00001;
	vec3 n_in5p3 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in5p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out2p4 - n_in5p1) < n_in5p2)
	{
		n_out5p0 = n_in5p3;
	}
	else if(n_out2p4 < n_in5p1)
	{
		n_out5p0 = n_in5p5;
	}
	else
	{
		n_out5p0 = vec3(n_out6p0.xyz);
	}


// VectorOp:7
	vec4 n_out7p0 = n_out2p0 + vec4(n_out5p0, 0.0);


// Input:13
	float n_out13p0 = TIME;


// FloatOp:19
	float n_in19p1 = 3.00000;
	float n_out19p0 = n_out13p0 * n_in19p1;


// FloatFunc:14
	float n_out14p0 = sin(n_out19p0);


// FloatOp:17
	float n_in17p1 = 1.00000;
	float n_out17p0 = n_out14p0 + n_in17p1;


// FloatOp:18
	float n_in18p1 = 2.00000;
	float n_out18p0 = n_out17p0 / n_in18p1;


// FloatOp:20
	float n_in20p1 = 0.10000;
	float n_out20p0 = n_out18p0 + n_in20p1;


// FloatOp:15
	float n_out15p0 = n_out2p4 * n_out20p0;


// Clamp:16
	float n_in16p1 = 0.00000;
	float n_in16p2 = 0.50500;
	float n_out16p0 = clamp(n_out15p0, n_in16p1, n_in16p2);


// Output:0
	ALBEDO = vec3(n_out7p0.xyz);
	ALPHA = n_out16p0;


}
