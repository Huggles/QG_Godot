        "dependsOn": "build"
      },
      {
        "label": "Launch Two Instances (Normal)",
        "detail": "Two plain GUI instances at the main menu: no debug multiplayer, no auto host/join, no team assignments.",
        "type": "shell",
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/quick_launch_normal.ps1"
        ],
        "problemMatcher": [],
        "presentation": {
          "echo": true,
