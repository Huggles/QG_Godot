# ---- Host options ----

#. en: Host Game
msgid "HOST_TITLE"
msgstr "Spel hosten"

#. en: Hosts through Steam, so no port forwarding is needed.
msgid "HOST_HINT"
msgstr "Host via Steam, dus port forwarding is niet nodig."

#. en: Everyone who joins needs the expansions you tick.
msgid "HOST_EXPANSION_HINT"
msgstr "Iedereen die deelneemt heeft de uitbreidingen nodig die je aanvinkt."

#. en: Players
msgid "HOST_PLAYERS_LABEL"
msgstr "Spelers"

#. en: Visibility
msgid "HOST_VISIBILITY_LABEL"
msgstr "Zichtbaarheid"

#. en: Friends only
msgid "HOST_PRIVACY_FRIENDS"
msgstr "Alleen vrienden"

#. en: Private (invite only)
msgid "HOST_PRIVACY_PRIVATE"
msgstr "Privé (alleen op uitnodiging)"

#. en: Friends-only games appear in your friends' game list. Private games do not — invite players from the lobby instead.
msgid "HOST_PRIVACY_HINT"
msgstr "Spellen voor alleen vrienden staan in de spellenlijst van je vrienden. Privéspellen niet — nodig spelers dan uit vanuit de lobby."

#. en: CANCEL
msgid "HOST_BTN_CANCEL"
msgstr "ANNULEREN"

#. en: Hosts over a direct connection instead. Players join with your IP address, and port 7777 may need forwarding.
msgid "HOST_IP_TOOLTIP"
msgstr "Host in plaats daarvan via een directe verbinding. Spelers nemen deel met je IP-adres, en poort 7777 moet mogelijk worden doorgestuurd."

#. en: Host over IP instead
msgid "HOST_BTN_IP_INSTEAD"
msgstr "Liever via IP hosten"

#. en: CREATE STEAM LOBBY
msgid "HOST_BTN_CREATE_LOBBY"
msgstr "STEAM-LOBBY MAKEN"

#. en: Host over IP
msgid "HOST_BTN_IP"
msgstr "Via IP hosten"

#. en: The save was played with these, so they cannot be changed.
msgid "HOST_EXPANSION_HINT_FIXED"
msgstr "Het opgeslagen spel is hiermee gespeeld, dus ze kunnen niet worden gewijzigd."

#. en: Steam is unavailable: {0}.
msgid "HOST_STEAM_UNAVAILABLE"
msgstr "Steam is niet beschikbaar: {0}."

#. en: This build has no Steam networking support.
msgid "HOST_NO_STEAM_NETWORKING"
msgstr "Deze build ondersteunt geen Steam-netwerk."

#. en: Creating Steam lobby...
msgid "HOST_CREATING_LOBBY"
msgstr "Steam-lobby maken..."

#. en: Could not create a Steam lobby
msgid "HOST_LOBBY_FAILED_TITLE"
msgstr "Kon geen Steam-lobby maken"

#. en: Steam did not create the lobby. You can still host over Godot networking.
msgid "HOST_LOBBY_FAILED_MESSAGE"
msgstr "Steam heeft de lobby niet gemaakt. Je kunt nog steeds hosten via Godot-netwerk."

