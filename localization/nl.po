# ---- Settings: Gameplay ----

#. en: PACE
msgid "SETTINGS_GAMEPLAY_PACE_SECTION"
msgstr "TEMPO"

#. en: Presentation Speed
msgid "SETTINGS_GAMEPLAY_SPEED_LABEL"
msgstr "Animatiesnelheid"

#. en: Slow
msgid "SETTINGS_GAMEPLAY_SPEED_SLOW"
msgstr "Langzaam"

#. en: Normal
msgid "SETTINGS_GAMEPLAY_SPEED_NORMAL"
msgstr "Normaal"

#. en: Fast
msgid "SETTINGS_GAMEPLAY_SPEED_FAST"
msgstr "Snel"

#. en: How fast animations play and how long the game pauses between them.
msgid "SETTINGS_GAMEPLAY_SPEED_HINT"
msgstr "Hoe snel animaties afspelen en hoe lang het spel ertussen pauzeert."

#. en: Auto-skip Messages
msgid "SETTINGS_GAMEPLAY_AUTO_DISMISS_LABEL"
msgstr "Berichten automatisch sluiten"

#. en: Messages that only report what happened close themselves after a moment instead of waiting for a click.
msgid "SETTINGS_GAMEPLAY_AUTO_DISMISS_HINT"
msgstr "Berichten die alleen melden wat er gebeurd is, sluiten zichzelf na een moment in plaats van op een klik te wachten."

#. en: Only Ask When I Can React
msgid "SETTINGS_GAMEPLAY_REACTION_PROMPTS_LABEL"
msgstr "Alleen vragen als ik kan reageren"

#. en: A reaction window with nothing you can play is answered for you, so it never stops the game. The toggle in each faction's info row still changes it for one game.
msgid "SETTINGS_GAMEPLAY_REACTION_PROMPTS_HINT"
msgstr "Een reactievenster waarin je niets kunt spelen, wordt voor je beantwoord, zodat het spel er nooit op stilvalt. De schakelaar in de inforegel van elke factie wijzigt dit nog steeds voor één spel."

#. en: CARDS
msgid "SETTINGS_GAMEPLAY_CARDS_SECTION"
msgstr "KAARTEN"

#. en: Pop-up Card Size
msgid "SETTINGS_GAMEPLAY_MODAL_CARD_SIZE_LABEL"
msgstr "Kaartgrootte in pop-ups"

#. en: How big cards are drawn in pop-ups that show drawn, discarded or offered cards. Bigger cards are easier to read; smaller ones leave more of the board in view.
msgid "SETTINGS_GAMEPLAY_MODAL_CARD_SIZE_HINT"
msgstr "Hoe groot kaarten worden getekend in pop-ups met getrokken, afgelegde of aangeboden kaarten. Grotere kaarten zijn beter leesbaar; kleinere laten meer van het bord zien."

#. en: Show Active Cards
msgid "SETTINGS_GAMEPLAY_ACTIVE_CARDS_LABEL"
msgstr "Actieve kaarten tonen"

#. en: When choosing a card to play, your Status and Response cards already on the table are drawn beside your hand, next to the cards you can activate instead of playing.
msgid "SETTINGS_GAMEPLAY_ACTIVE_CARDS_HINT"
msgstr "Bij het kiezen van een kaart worden je Status- en Reactiekaarten die al op tafel liggen naast je hand getoond, bij de kaarten die je kunt activeren in plaats van spelen."

#. en: Open Faction Banners
msgid "SETTINGS_GAMEPLAY_PENNANTS_OPEN_LABEL"
msgstr "Factiebanieren open"

#. en: The faction banners down the left start slid open, showing each faction's hand, score and pieces in reserve. Click a banner to open or close it either way.
msgid "SETTINGS_GAMEPLAY_PENNANTS_OPEN_HINT"
msgstr "De factiebanieren aan de linkerkant staan bij de start uitgeschoven, met de hand, score en reservestukken van elke factie. Klik op een banier om die alsnog te openen of te sluiten."

#. en: Faction Banner Size
msgid "SETTINGS_GAMEPLAY_BANNER_SIZE_LABEL"
msgstr "Grootte factiebanieren"

#. en: How big the flagpole and faction banners down the left are drawn, with the cards fanned out of each flag.
msgid "SETTINGS_GAMEPLAY_BANNER_SIZE_HINT"
msgstr "Hoe groot de vlaggenmast en de factiebanieren aan de linkerkant worden getekend, met de kaarten die uit elke vlag waaieren."

#. en: CHAT
msgid "SETTINGS_GAMEPLAY_CHAT_SECTION"
msgstr "CHAT"

#. en: Hide Chat After
msgid "SETTINGS_GAMEPLAY_CHAT_HIDE_LABEL"
msgstr "Chat verbergen na"

#. en: Never
msgid "SETTINGS_GAMEPLAY_CHAT_HIDE_NEVER"
msgstr "Nooit"

#. en: 5 seconds
msgid "SETTINGS_GAMEPLAY_CHAT_HIDE_5S"
msgstr "5 seconden"

#. en: 10 seconds
msgid "SETTINGS_GAMEPLAY_CHAT_HIDE_10S"
msgstr "10 seconden"

#. en: How long the chat stays on screen after a player message or once the mouse leaves it.
msgid "SETTINGS_GAMEPLAY_CHAT_HIDE_HINT"
msgstr "Hoe lang de chat in beeld blijft na een bericht van een speler of zodra de muis hem verlaat."

#. en: DIAGNOSTICS
msgid "SETTINGS_GAMEPLAY_DIAGNOSTICS_SECTION"
msgstr "DIAGNOSE"

#. en: Debug Logging
msgid "SETTINGS_GAMEPLAY_DEBUG_LEVEL_LABEL"
msgstr "Debuglogging"

#. en: Info
msgid "SETTINGS_GAMEPLAY_DEBUG_LEVEL_INFO"
msgstr "Info"

#. en: Finest
msgid "SETTINGS_GAMEPLAY_DEBUG_LEVEL_FINEST"
msgstr "Zeer gedetailleerd"

#. en: How much detail is written to the console. Finest is loud and only useful when diagnosing a problem.
msgid "SETTINGS_GAMEPLAY_DEBUG_LEVEL_HINT"
msgstr "Hoeveel detail er naar de console wordt geschreven. Zeer gedetailleerd is erg uitvoerig en alleen nuttig bij het opsporen van een probleem."

