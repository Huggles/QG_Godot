#!args scenario=Scenario_Debug_AirForces seed=42
#
# Total War Air step: Marshal, then the patron's extra marshal of its minor ally's Air Force. A marshal
# asks which card pays, then which Air Force, then where. The UK moves its Air Force from Western
# Europe to the North Sea (any space with its own supplied Army or Navy), then marshals France's Air
# Force, which may stay where it is (its only French space) to trigger a reaction. The scenario deals
# the UK its whole opening hand, so the UK's cards are named rather than numbered.
#
# Run:  tests/run-cli.sh tests/qgc/air_step_marshal_with_minor.qgc

prompt                                  # turn 1, Germany — synchronise with the running game
pass                                    # Germany: no play
answer id=20                            # discard Dive Bombers
select Pass                             # Germany's Air step
pass                                    # Germany's Discard step

assert handsize UNITED_KINGDOM == 7     # turn 2, the United Kingdom
pass                                    # no play
select Singapore Fortified              # discard it
select Marshal
select Air Power                        # pay with the Air Power card: any card will do
answer id=65                            # the UK's Air Force: asked even though it is the only one
select North Sea
assert promptfaction == UNITED_KINGDOM  # France has no seat: its patron is asked
select Marshal
select Build Navy                       # pay with it
answer id=74                            # France's Air Force
select Western Europe

prompt                                  # wait for the moves to settle
assert airforce NORTH_SEA UNITED_KINGDOM == 1
assert airforce WESTERN_EUROPE UNITED_KINGDOM == 0
assert airforce WESTERN_EUROPE FRANCE == 1
assert handsize UNITED_KINGDOM == 4
