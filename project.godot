; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Quartermaster General"
run/main_scene="res://scenes/menu/MainScene.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

ErrorReporter="*res://scripts/C#/Errors/ErrorReporter.cs"
GameSettings="*res://scripts/C#/Utils/GameSettings.cs"
AudioManager="*res://scripts/C#/Utils/AudioManager.cs"
NodeUtilities="*res://scripts/C#/Utils/NodeUtilities.cs"
DebugUtilities="*res://scripts/C#/Utils/DebugUtilities.cs"
GameManager="*res://scripts/C#/Game/GameManager.cs"
TagRegistry="*res://scripts/C#/Utils/Tags/TagRegistry.cs"
NetworkApi="*res://scripts/C#/Utils/NetworkApi.cs"
ChangeEventQueue="*res://scenes/network/ChangeEventQueue.cs"
AnimationQueue="*res://scripts/C#/Animations/AnimationQueue.cs"
CliSession="*res://scripts/C#/Cli/CliSession.cs"
SteamworksApi="*res://scripts/C#/Utils/SteamworksApi.cs"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/unused_signal=0

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Quartermaster General"

[editor]

run/main_run_args="--is_debug=1 --game_mode=default"

[editor_plugins]

enabled=PackedStringArray("res://addons/csharp_wrapper_generator_for_gdextension/plugin.cfg", "res://addons/godotsteam/plugin.cfg", "res://addons/godotsteam_csharpbindings/plugin.cfg")

