[layer_names]

3d_render/layer_1="Player Render Layer"
3d_render/layer_2="World Render Layer"
3d_physics/layer_1="Player Physics Layer"
3d_physics/layer_2="World Physics Layer"

[rendering]

textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(1, 1, 1, 1)

[steam]

initialization/app_data/app_type=2
initialization/app_data/app_id=480
initialization/app_data/demo_id=480
initialization/app_data/playtest_id=480
initialization/app_data/tool_id=480
initialization/processes/initialize_on_startup=true
initialization/processes/embed_callbacks=true
